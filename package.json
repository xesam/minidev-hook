{
    "name": "@mini-dev/hook",
    "version": "0.5.1",
    "description": "miniapp framework methods(App, Page, Component) hook",
    "publishConfig": {
        "access": "public"
    },
    "main": "dist/index.js",
    "module": "dist/esm/index.js",
    "exports": {
        ".": {
            "import": "./dist/esm/index.js",
            "require": "./dist/index.js"
        }
    },
    "directories": {
        "src": "src",
        "test": "tests"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "npm run clean && tsup && npm run build:markers",
        "build:markers": "node -e \"require('fs').writeFileSync('dist/package.json', JSON.stringify({type:'commonjs'})); require('fs').writeFileSync('dist/esm/package.json', JSON.stringify({type:'module'}))\"",
        "dev": "tsup --watch",
        "clean": "rimraf dist",
        "prepublishOnly": "npm run clean && npm run build",
        "test": "jest"
    },
    "repository": {
        "type": "git",
        "url": "git+git@github.com:xesam/minidev-hook.git"
    },
    "bugs": {
        "url": "https://github.com/xesam/minidev-hook"
    },
    "homepage": "https://github.com/xesam/minidev-hook",
    "dependencies": {
        "object-hook": "^0.1.1"
    },
    "devDependencies": {
        "esbuild": "^0.27.7",
        "jest": "29.7.0",
        "rimraf": "^6.1.3",
        "tsup": "^8.5.1",
        "typescript": "^7.0.2"
    },
    "keywords": [
        "微信",
        "小程序",
        "miniapp",
        "hook",
        "lifecycle",
        "App",
        "Page",
        "Component"
    ],
    "author": "xesam",
    "license": "MIT"
}
